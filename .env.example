# ==============================================================================
# Autonomous Bug Fixer Agent — Environment Configuration Template
# Copy this file to .env and configure your desired API key(s)
# ==============================================================================

# --- Provider Selection & Chain Order ---
# Supported providers: gemini, groq, openai, anthropic
PRIMARY_PROVIDER=gemini
PROVIDER_CHAIN=gemini,groq,openai,anthropic

# --- Google Gemini Configuration (Recommended Default: Ultra-low cost) ---
GOOGLE_API_KEY1=your_google_gemini_api_key_here
GOOGLE_API_KEY2=optional_secondary_gemini_key_here
GOOGLE_API_KEY3=optional_tertiary_gemini_key_here
GEMINI_MODEL1=gemini-flash-latest
GEMINI_MODEL2=gemini-2.5-flash

# --- Groq Configuration (High Speed & Fallback) ---
GROQ_API_KEY1=your_groq_api_key_here
GROQ_API_KEY2=optional_secondary_groq_key_here
GROQ_MODEL1=openai/gpt-oss-120b
GROQ_MODEL2=openai/gpt-oss-20b

# --- OpenAI Configuration (Optional) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL1=gpt-4o
OPENAI_MODEL2=gpt-4o-mini

# --- Anthropic Configuration (Optional) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL1=claude-3-5-sonnet-20241022
ANTHROPIC_MODEL2=claude-3-5-haiku-20241022

# --- Execution Limits & Safety Guards ---
MAX_ATTEMPTS_PER_BUG=3
MAX_COST_BUDGET_USD=5.00
SUBPROCESS_TIMEOUT_SECONDS=30
AUTO_GIT_ROLLBACK=true
